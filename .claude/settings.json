{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/run-hook.cmd\" session-start-superpowers",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/skills/seo/hooks/run-python-hook.js\" \"$CLAUDE_PROJECT_DIR/.claude/skills/seo/hooks/validate-schema.py\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
