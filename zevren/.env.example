# Copy to .env.local and fill in. Never commit the filled file.
# Nothing here is prefixed NEXT_PUBLIC_, so no value reaches the browser.

# --- Database -------------------------------------------------------------
# Production: a Postgres connection string (Vercel Postgres, Neon, Supabase).
# Vercel's Postgres integration injects POSTGRES_URL; that name is accepted too.
DATABASE_URL=

# Local development and tests can run against an embedded Postgres instead of
# a server. Refused in production by lib/server/env.ts.
#   DATABASE_DRIVER=pglite
DATABASE_DRIVER=postgres
PGLITE_DATA_DIR=./.pglite

# --- Secrets --------------------------------------------------------------
# 32+ random bytes. Generate with: openssl rand -base64 48
# Rotating this invalidates every session and CSRF token.
AUTH_SECRET=

# Canonical https origin, used for the Origin check on writes.
APP_ORIGIN=https://www.zevren.nl

# Session lifetimes in seconds.
SESSION_ABSOLUTE_TTL=28800
SESSION_IDLE_TTL=1800

# --- Email ----------------------------------------------------------------
# Optional. Without these, submissions are stored but not mailed.
RESEND_API_KEY=
CONTACT_INBOX_EMAIL=info@zevren.nl
MAIL_FROM=ZEVREN website <noreply@zevren.nl>

# Set to false if the app is not behind a proxy that rewrites x-forwarded-for.
TRUST_PROXY=true

# --- Admin bootstrap (used by `npm run admin:create`, never at runtime) ----
# ADMIN_EMAIL=
# ADMIN_PASSWORD=
