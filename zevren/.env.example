# Copy this file to .env.local and fill in the values you need.
# The site needs DATABASE_URL in production so contact messages can be saved
# and the admin dashboard can authenticate. Use the full connection string
# from Neon (or POSTGRES_URL from Vercel Postgres).
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Used once to bootstrap the production /admin account. Keep these only in
# Vercel's Production environment; never commit them to an env file.
ADMIN_EMAIL=info@zevren.nl
ADMIN_PASSWORD=

# Public site URL, used for canonical URLs, sitemap.xml and structured data.
# Defaults to https://www.zevren.nl in lib/constants.ts if not set.
NEXT_PUBLIC_SITE_URL=https://www.zevren.nl

# --- Resend (contact form email delivery) --------------------------------
# Not yet wired up. See the TODO in app/api/contact/route.ts — once you add
# the Resend integration there, these two variables drive it.
RESEND_API_KEY=
CONTACT_INBOX_EMAIL=info@zevren.nl
